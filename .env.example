# Spotify application Client ID, from https://developer.spotify.com/dashboard
#
# Create an app, then add this exact redirect URI:
#   http://127.0.0.1:8888/callback
# Use 127.0.0.1, NOT localhost -- Spotify rejects localhost for new redirect URIs.
#
# Scopes needed: user-read-playback-state user-read-currently-playing
#
# There is no client secret. Lyric Veil uses Authorization Code + PKCE, so no
# secret is ever shipped in the binary.
MAIN_VITE_SPOTIFY_CLIENT_ID=
